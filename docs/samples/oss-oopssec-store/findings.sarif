              {
                "id": "entry:v1:04e57f2ad45966b2b46a7fc25bd7c591528395d8228589c343b90defa215abc0",
                "kind": "http",
                "name": "GET /api/orders",
                "instance_id": "app/api/orders/route.ts:38380ce5f73238739823ff5b73e1f0dc235c79d81152a2779fb5fd9121ffd542:nextjs",
                "location": {
                  "kind": "entry_registration",
                  "text": "export const GET = withAdminAuth(async (_request, _context, _user) =\u003e {\n  try {\n    const orders = await prisma.order.findMany({\n      include: {\n        user: {\n          select: {\n            email: true,\n          },\n        },\n        address: true,\n      },\n      orderBy: {\n        id: \"desc\",\n      },\n    });\n\n    return NextResponse.json(orders);\n  } catch (error) {\n    logger.error({ err: error, route: \"/api/orders\" }, \"Error fetching orders\");\n    return NextResponse.json(\n      { error: \"Failed to fetch orders\" },\n      { status: 500 }\n    );\n  }\n});",
                  "span": {
                    "file": "app/api/orders/route.ts",
                    "start_line": 9,
                    "end_line": 33,
                    "start_byte": 365,
                    "end_byte": 931
                  },
