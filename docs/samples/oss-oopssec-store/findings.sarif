                "id": "registration:v1:58cd953c754493be185c8cb870b93e4b6cb6b6220c4f187d862947404209d7f8",
                "entry_id": "entry:v1:4bc79731ec9f79e845a333c48a94ffd9690ff6fa38dbe64d676ce893a4dd2861",
                "origin": {
                  "kind": "entry_registration",
                  "text": "export async function GET() {\n  try {\n    const [foundFlags, projectInit, totalFlags, allFlags] = await Promise.all([\n      prisma.foundFlag.findMany({\n        include: {\n          flag: {\n            select: {\n              slug: true,\n              category: true,\n              difficulty: true,\n              cve: true,\n              cwe: true,\n              owasp: true,\n              walkthroughSlug: true,\n            },\n          },\n        },\n        orderBy: {\n          foundAt: \"asc\",\n        },\n      }),\n      prisma.projectInit.findFirst(),\n      prisma.flag.count(),\n      prisma.flag.findMany({\n        select: {\n          category: true,\n          difficulty: true,\n        },\n      }),\n    ]);\n\n    const statsByCategory = allFlags.reduce(\n      (acc, flag) =\u003e {\n        acc[flag.category] = (acc[flag.category] || 0) + 1;\n        return acc;\n      },\n      {} as Record\u003cstring, number\u003e\n    );\n\n    const statsByDifficulty = allFlags.reduce(\n      (acc, flag) =\u003e {\n        acc[flag.difficulty] = (acc[flag.difficulty] || 0) + 1;\n        return acc;\n      },\n      {} as Record\u003cstring, number\u003e\n    );\n\n    return NextResponse.json({\n      foundFlags: foundFlags.map((f) =\u003e ({\n        slug: f.flag.slug,\n        category: f.flag.category,\n        difficulty: f.flag.difficulty,\n        cve: f.flag.cve,\n        cwe: f.flag.cwe,\n        owasp: f.flag.owasp,\n        walkthroughSlug: f.flag.walkthroughSlug,\n        foundAt: f.foundAt.toISOString(),\n      })),\n      initializedAt: projectInit?.initializedAt.toISOString() ?? null,\n      totalFlags,\n      statsByCategory,\n      statsByDifficulty,\n    });\n  } catch (error) {\n    logger.error(\n      { err: error, route: \"/api/flags/progress\" },\n      \"Error fetching progress\"\n    );\n    return NextResponse.json(\n      { error: \"Failed to fetch progress\" },\n      { status: 500 }\n    );\n  }\n}",
                  "span": {
