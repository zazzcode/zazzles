                {
                  "kind": "helper_definition",
                  "text": "public function __construct(\n    ) {\n        $cookieTheme = self::getFromCookie();\n        if (!$cookieTheme) {\n            $this-\u003etheme = 'light';\n            self::setCookie($this);\n        } else {\n            $this-\u003etheme = $cookieTheme-\u003eget();\n        }\n    }",
