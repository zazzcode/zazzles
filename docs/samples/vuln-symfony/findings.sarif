              ],
              "controls": [
                {
                  "kind": "invoked_callable",
                  "text": "#[Route('/users', name: 'users')]\n    public function users(\n        Request        $request,\n        UserRepository $userRepository\n    ): Response\n    {\n        if (!$this-\u003eisLocalRequest($request)) {\n            return new Response('Access denied', Response::HTTP_FORBIDDEN);\n        }\n\n        $users = $userRepository-\u003efindAll();\n\n        $list = \"List of users:\\n\\n\";\n        foreach ($users as $user) {\n            $rights = in_array('ROLE_ADMIN', $user-\u003egetRoles()) ? 'Administrator' : 'User';\n            $list .=\n                $user-\u003egetId(). ' | ' .\n                $rights . ' | ' .\n                $user-\u003egetUsername() . ' | ' .\n                $user-\u003egetEmail() . \"\\n\";\n        }\n\n        return new Response($list);\n    }",
                  "span": {
                    "file": "src/Controller/LocalController.php",
                    "start_line": 41,
                    "end_line": 64,
                    "start_byte": 1236,
                    "end_byte": 1974
                  },
                  "sha256": "a664a6ba18084d09286c3ccad884a5ca59624fd487b1b52d36ee59b5bf717f83"
                },
                {
                  "kind": "entry_registration",
                  "text": "Route('/users', name: 'users')",
                  "span": {
                    "file": "src/Controller/LocalController.php",
                    "start_line": 41,
                    "end_line": 41,
                    "start_byte": 1238,
                    "end_byte": 1268
                  },
                  "sha256": "a664a6ba18084d09286c3ccad884a5ca59624fd487b1b52d36ee59b5bf717f83"
                },
                {
                  "kind": "helper_definition",
                  "text": "public function __construct(ManagerRegistry $registry)\n    {\n        parent::__construct($registry, User::class);\n    }",
                  "span": {
                    "file": "src/Repository/UserRepository.php",
                    "start_line": 23,
                    "end_line": 26,
                    "start_byte": 853,
