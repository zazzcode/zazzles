                    "text": "function withAdminAuth(handler: AuthenticatedHandler) {\n  return withAuth(async (request, context, user) =\u003e {\n    if (user.role !== \"ADMIN\") {\n      return NextResponse.json({ error: \"Forbidden\" }, { status: 403 });\n    }\n    return handler(request, context, user);\n  });\n}",
