            "scan.entry": {
              "id": "entry:v1:976a8a8910f7f2fb782ddbe8506a3a205e33a0c79ce77f1a627978a2d6bbe224",
              "kind": "http",
              "name": "POST /api/auth/login",
              "instance_id": "app/api/auth/login/route.ts:3531c70dad04f480e0416407f6eaccaea03abb7532261a4612d572823dfa1100:nextjs",
              "location": {
                "kind": "entry_registration",
                "text": "export async function POST(request: Request) {\n  try {\n    const parsed = await parseBody(request, loginBodySchema);\n    if (!parsed.success) return parsed.response;\n    const { email, password, redirect } = parsed.data;\n\n    logger.warn(\n      {\n        email,\n        password,\n        flag: LOGIN_FLAG,\n        route: \"/api/auth/login\",\n        action: \"login_attempt\",\n      },\n      `[auth] login attempt email=${email} password=${password} flag=${LOGIN_FLAG}`\n    );\n\n    const hashedPassword = hashMD5(password);\n\n    const user = await prisma.user.findUnique({\n      where: { email },\n      select: {\n        id: true,\n        email: true,\n        password: true,\n        role: true,\n      },\n    });\n\n    if (!user) {\n      return NextResponse.json(\n        { error: \"Invalid credentials\" },\n        { status: 401 }\n      );\n    }\n\n    if (user.password !== hashedPassword) {\n      return NextResponse.json({ error: \"Invalid password\" }, { status: 401 });\n    }\n\n    const token = createWeakJWT({\n      id: user.id,\n      email: user.email,\n      role: user.role,\n      hint: \"The secret is not so secret\",\n      exp: Math.floor(Date.now() / 1000) + 60 * 60 * 24 * 7,\n    });\n\n    const isVisBruta = user.email === \"vis.bruta@example.com\";\n    let flagData = null;\n\n    if (isVisBruta) {\n      const bruteForceFlag = await prisma.flag.findUnique({\n        where: { slug: \"brute-force-no-rate-limiting\" },\n      });\n      if (bruteForceFlag) {\n        flagData = bruteForceFlag.flag;\n      }\n    }\n\n    const response = NextResponse.json({\n      user: {\n        id: user.id,\n        email: user.email,\n        role: user.role,\n      },\n      flag: flagData,\n    });\n\n    setAuthCookie(response, token);\n\n    if (redirect) {\n      response.cookies.set(\"oauth_callback\", \"1\", {\n        httpOnly: true,\n        secure: process.env.NODE_ENV === \"production\",\n        sameSite: \"lax\",\n        maxAge: 60,\n        path: \"/internal/oauth/callback\",\n      });\n    }\n\n    return response;\n  } catch (error) {\n    logger.error(\n      { err: error, route: \"/api/auth/login\" },\n      \"Error during login\"\n    );\n    return NextResponse.json(\n      { error: \"Failed to authenticate\" },\n      { status: 500 }\n    );\n  }\n}",
                "span": {
