              {
                "id": "entry:v1:ec6fc775741f9bdde5c1aff524c786919ced618a4092f7f2f5b9fa5a93a12ecc",
                "kind": "http",
                "name": "GET /api/vcs/:path*?",
                "instance_id": "app/api/vcs/[[...path]]/route.ts:d8166be33c7fd5cd7fee7ffc7c8b40105c4880727e391206a5c9dd06edb80ac5:nextjs",
                "location": {
                  "model_text": "export async function GET(\n  request: NextRequest,\n  { params }: { params: Promise\u003c{ path?: string[] }\u003e }\n) {\n  const { path = [] } = await params;\n  const relative = path.join(\"/\");\n\n  const flag = await prisma.flag.findUnique({\n    where: { slug: \"exposed-git-repository\" },\n  });\n  if (!flag) {\n    throw new Error(\n      \"Flag exposed-git-repository is missing: seed the database\"\n    );\n  }\n\n  const repository = buildExposedRepository(flag.flag);\n\n  const file = repository.get(relative);\n  if (file) {\n    return new NextResponse(new Uint8Array(file), {\n      headers: { \"Content-Type\": \"application/octet-stream\" },\n    });\n  }\n\n  const directory = relative === \"\" ? \"\" : `${relative}/`;\n  const children = listChildren(repository, directory);\n  if (children.size === 0) {\n    return new NextResponse(NOT_FOUND, {\n      status: 404,\n      headers: { \"Content-Type\": \"text/html\" },\n    });\n  }\n\n                                                                       \n  if (!request.nextUrl.pathname.endsWith(\"/\")) {\n    return NextResponse.redirect(\n      new URL(`${PUBLIC_ROOT}${directory}`, request.url),\n      301\n    );\n  }\n\n  return new NextResponse(renderListing(directory, children), {\n    headers: { \"Content-Type\": \"text/html\" },\n  });\n}",
                  "kind": "entry_registration",
                  "text": "export async function GET(\n  request: NextRequest,\n  { params }: { params: Promise\u003c{ path?: string[] }\u003e }\n) {\n  const { path = [] } = await params;\n  const relative = path.join(\"/\");\n\n  const flag = await prisma.flag.findUnique({\n    where: { slug: \"exposed-git-repository\" },\n  });\n  if (!flag) {\n    throw new Error(\n      \"Flag exposed-git-repository is missing: seed the database\"\n    );\n  }\n\n  const repository = buildExposedRepository(flag.flag);\n\n  const file = repository.get(relative);\n  if (file) {\n    return new NextResponse(new Uint8Array(file), {\n      headers: { \"Content-Type\": \"application/octet-stream\" },\n    });\n  }\n\n  const directory = relative === \"\" ? \"\" : `${relative}/`;\n  const children = listChildren(repository, directory);\n  if (children.size === 0) {\n    return new NextResponse(NOT_FOUND, {\n      status: 404,\n      headers: { \"Content-Type\": \"text/html\" },\n    });\n  }\n\n  // The rewrite keeps the requested pathname, trailing slash included.\n  if (!request.nextUrl.pathname.endsWith(\"/\")) {\n    return NextResponse.redirect(\n      new URL(`${PUBLIC_ROOT}${directory}`, request.url),\n      301\n    );\n  }\n\n  return new NextResponse(renderListing(directory, children), {\n    headers: { \"Content-Type\": \"text/html\" },\n  });\n}",
