                  "text": "static public function getFromCookie(): ?UserPref {\n        $cookie = $_COOKIE['USER_PREF'] ?? null;\n        if (!$cookie) {\n            return null;\n        }\n\n        $data = base64_decode(urldecode($cookie));\n        return unserialize($data);\n    }",
