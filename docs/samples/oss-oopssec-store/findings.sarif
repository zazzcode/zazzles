            "scan.entry": {
              "id": "entry:v1:c1bd184a1c9b747a1ccfcf80458a256ab75b7c162767d1541163db75e950fa92",
              "kind": "http",
              "name": "GET /api/uploads/:path*",
              "instance_id": "app/api/uploads/[...path]/route.ts:2856628be426083b91a491b53c01eed42a2e4ff1bb170f2371a812a7247a14e4:nextjs",
              "location": {
                "kind": "entry_registration",
                "text": "export async function GET(\n  _request: NextRequest,\n  { params }: { params: Promise\u003c{ path: string[] }\u003e }\n) {\n  const { path } = await params;\n  const filename = path.join(\"/\");\n\n  if (filename.includes(\"..\") || filename.includes(\"\\0\")) {\n    return NextResponse.json({ error: \"Invalid path\" }, { status: 400 });\n  }\n\n  const filepath = join(process.cwd(), \"uploads\", filename);\n\n  if (!existsSync(filepath)) {\n    return NextResponse.json({ error: \"File not found\" }, { status: 404 });\n  }\n\n  const ext = filename.substring(filename.lastIndexOf(\".\")).toLowerCase();\n  const contentType = MIME_TYPES[ext];\n\n  if (!contentType) {\n    return NextResponse.json(\n      { error: \"Unsupported file type\" },\n      { status: 400 }\n    );\n  }\n\n  const fileBuffer = await readFile(filepath);\n\n  return new NextResponse(fileBuffer, {\n    headers: {\n      \"Content-Type\": contentType,\n      \"Cache-Control\": \"public, max-age=31536000, immutable\",\n    },\n  });\n}",
                "span": {
                  "file": "app/api/uploads/[...path]/route.ts",
