# New setups only: copy to .env, add your key locally, then load this trusted file:
# set -a; . ./.env; set +a
# The scanner does not load .env automatically. Never commit credentials.
SCAN_FINDINGS_DIR="$HOME/zazzles-findings"

# Decision model for a judged scan. One selection applies to every analyzer.
# Run with --judge openai for this setup.
JUDGE_DECISION_MODEL=gpt-6-luna
OPENAI_API_KEY=

# Optional cap on candidates one scan may send for assessment (default: no cap).
# Transient failures are retried up to 3 times without using a slot (HTTP requests <= 4x).
# Spending limits belong in the provider account; --judge-limit overrides this.
# JUDGE_LIMIT=1000

# Optional family selection; choose at most one. Flags override these defaults.
# JUDGE_ONLY_FAMILY=path,command
# JUDGE_SKIP_FAMILY=outbound,input-validation

# Optional quota pacing; zero/unset disables it. Manage spending in the API console.
# Set each just under your account's limits, e.g. JUDGE_RPM=450 for a 500 RPM tier
# and JUDGE_TPM=450000 for 500k TPM (the estimate is bytes/3 + 512 per request).
# JUDGE_RPM=0
# JUDGE_TPM=0

# Assessment requests in flight at once (default 4; 1 is serial). RPM/TPM still apply.
# JUDGE_CONCURRENCY=4

# Other judge providers. To switch, replace the active model assignment above and
# use the matching --judge provider; reload in a fresh shell to clear stale values.
# Gemini: JUDGE_DECISION_MODEL=gemini-decision-1 with --judge gemini.
# GEMINI_API_KEY=
# Jev: explicit catalog model (for example, jev-1.14.0) with --judge jev.
# Zazzles verifies this adapter against local stubs.
# TYPESAFE_API_KEY=
# --judge-model must match JUDGE_DECISION_MODEL. No automatic provider fallback.

# Dependency Audit (audit): advisory detail from NIST's National Vulnerability Database.
# Request a free key at https://nvd.nist.gov/developers/request-an-api-key and paste it here.
# Without a key NVD allows about 5 requests per 30 seconds; with one, about 50. An empty value
# means no key. In CI, set NVD_API_KEY as a repository secret instead of using this file.
NVD_API_KEY=
