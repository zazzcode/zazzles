# New setups only: copy to .env, add your key locally, then load this trusted file:
# set -a; . ./.env; set +a
# The scanner does not load .env automatically. Never commit credentials.
SCAN_FINDINGS_DIR="$HOME/zazzles-findings"

# Primary model; one selection applies to every analyzer. Run with --judge openai.
JUDGE_DECISION_MODEL=gpt-6-luna
OPENAI_API_KEY=

# Assessment requests per run. Manage spending and quotas in your API account.
JUDGE_LIMIT=10

# Optional family selection; choose at most one. Flags override these defaults.
# JUDGE_ONLY_FAMILY=path,command
# JUDGE_SKIP_FAMILY=outbound,input-validation

# Optional quota pacing; zero/unset disables it. Manage spending in the API console.
# JUDGE_RPM=0
# JUDGE_TPM=0

# Optional adapters. To switch, replace the active model assignment above and
# use the matching --judge provider; reload in a fresh shell to clear stale values.
# Gemini: JUDGE_DECISION_MODEL=gemini-decision-1 with --judge gemini.
# GEMINI_API_KEY=
# Jev: explicit catalog model with --judge jev (stub-tested adapter).
# TYPESAFE_API_KEY=
# --judge-model must match JUDGE_DECISION_MODEL. No automatic provider fallback.
