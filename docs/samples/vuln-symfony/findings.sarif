                {
                  "kind": "helper_definition",
                  "text": "public function findByPostOrdered(int $postId): array\n    {\n        return $this-\u003ecreateQueryBuilder('c')\n            -\u003eandWhere('c.post = :postId')\n            -\u003esetParameter('postId', $postId)\n            -\u003eorderBy('c.date', 'ASC')\n            -\u003egetQuery()\n            -\u003egetResult();\n    }",
