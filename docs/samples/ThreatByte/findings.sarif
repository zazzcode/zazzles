                },
                {
                  "model_text": "def get_user_details_from_database(user_id):\r\n                                                               \r\n    with get_db_connection() as conn:\r\n        cursor = conn.cursor()\r\n        query = \"SELECT * FROM users WHERE id = ?\"\r\n        cursor.execute(query, (user_id,))\r\n        user = cursor.fetchone()\r\n    return user",
                  "kind": "helper_definition",
                  "text": "def get_user_details_from_database(user_id):\r\n    # Query the database for the user using parameterized query\r\n    with get_db_connection() as conn:\r\n        cursor = conn.cursor()\r\n        query = \"SELECT * FROM users WHERE id = ?\"\r\n        cursor.execute(query, (user_id,))\r\n        user = cursor.fetchone()\r\n    return user",
                  "span": {
