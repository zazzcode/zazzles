                },
                {
                  "kind": "helper_definition",
                  "text": "public function __construct(ManagerRegistry $registry)\n    {\n        parent::__construct($registry, Post::class);\n    }",
                  "span": {
                    "file": "src/Repository/PostRepository.php",
                    "start_line": 20,
                    "end_line": 23,
                    "start_byte": 573,
                    "end_byte": 692
