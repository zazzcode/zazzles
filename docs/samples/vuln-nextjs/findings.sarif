                "instance_id": "pages/api/vulnerable-exec.js:0e4440c31654f9ae15e1fc045e66026fa536dd4dfeb1ea3eb02ae2ad14f50ddf:nextjs",
                "location": {
                  "model_text": "export default function handler(req, res) {\n  if (req.method !== 'POST') {\n    return res.status(405).json({ error: 'Method not allowed' });\n  }\n\n  const { command } = req.body;\n\n  if (!command) {\n    return res.status(400).json({ error: 'No command provided' });\n  }\n\n  console.log(`[VULNERABLE] Executing command: ${command}`);\n\n                                                        \n                                            \n  exec(command, { timeout: 5000, maxBuffer: 1024 * 1024 }, (error, stdout, stderr) =\u003e {\n    if (error) {\n      console.error(`[VULNERABLE] Command error:`, error);\n      return res.status(500).json({\n        error: error.message,\n        stderr: stderr,\n        code: error.code,\n        killed: error.killed\n      });\n    }\n\n    console.log(`[VULNERABLE] Command output:`, stdout);\n\n    res.status(200).json({\n      success: true,\n      command: command,\n      output: stdout,\n      stderr: stderr,\n      timestamp: Date.now()\n    });\n  });\n}",
                  "kind": "entry_registration",
                  "text": "export default function handler(req, res) {\n  if (req.method !== 'POST') {\n    return res.status(405).json({ error: 'Method not allowed' });\n  }\n\n  const { command } = req.body;\n\n  if (!command) {\n    return res.status(400).json({ error: 'No command provided' });\n  }\n\n  console.log(`[VULNERABLE] Executing command: ${command}`);\n\n  // EXTREMELY DANGEROUS: Executing user input directly!\n  // This allows Remote Code Execution (RCE)\n  exec(command, { timeout: 5000, maxBuffer: 1024 * 1024 }, (error, stdout, stderr) =\u003e {\n    if (error) {\n      console.error(`[VULNERABLE] Command error:`, error);\n      return res.status(500).json({\n        error: error.message,\n        stderr: stderr,\n        code: error.code,\n        killed: error.killed\n      });\n    }\n\n    console.log(`[VULNERABLE] Command output:`, stdout);\n\n    res.status(200).json({\n      success: true,\n      command: command,\n      output: stdout,\n      stderr: stderr,\n      timestamp: Date.now()\n    });\n  });\n}",
