                {
                  "kind": "render_markup_context",
                  "text": "                \u003cinput type=\"text\" id=\"team\" name=\"team\" value=\"{{ user.team }}\"\u003e",
                  "span": {
                    "file": "client/templates/edit_profile.html",
                    "start_line": 46,
                    "end_line": 46,
                    "start_byte": 1767,
