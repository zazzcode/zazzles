              "location": {
                "model_text": "export default function handler(req, res) {\n  if (req.method !== 'POST') {\n    return res.status(405).json({ error: 'Method not allowed' });\n  }\n\n  const { name, message } = req.body;\n\n                    \n  if (!name || typeof name !== 'string') {\n    return res.status(400).json({ error: 'Invalid name' });\n  }\n\n  if (!message || typeof message !== 'string') {\n    return res.status(400).json({ error: 'Invalid message' });\n  }\n\n                                                                    \n  const sanitizedName = name.replace(/[^a-zA-Z0-9\\s\\-_.]/g, '');\n  const sanitizedMessage = message.replace(/[^a-zA-Z0-9\\s\\-_.!?,]/g, '');\n\n                    \n  if (sanitizedName.length \u003e 100) {\n    return res.status(400).json({ error: 'Name too long' });\n  }\n\n  if (sanitizedMessage.length \u003e 1000) {\n    return res.status(400).json({ error: 'Message too long' });\n  }\n\n                                       \n  const result = {\n    name: sanitizedName,\n    message: sanitizedMessage,\n    timestamp: Date.now(),\n    processedBy: 'protected API'\n  };\n\n  res.status(200).json(result);\n}",
                "kind": "entry_registration",
                "text": "export default function handler(req, res) {\n  if (req.method !== 'POST') {\n    return res.status(405).json({ error: 'Method not allowed' });\n  }\n\n  const { name, message } = req.body;\n\n  // Validate inputs\n  if (!name || typeof name !== 'string') {\n    return res.status(400).json({ error: 'Invalid name' });\n  }\n\n  if (!message || typeof message !== 'string') {\n    return res.status(400).json({ error: 'Invalid message' });\n  }\n\n  // Sanitize inputs - only allow alphanumeric and basic punctuation\n  const sanitizedName = name.replace(/[^a-zA-Z0-9\\s\\-_.]/g, '');\n  const sanitizedMessage = message.replace(/[^a-zA-Z0-9\\s\\-_.!?,]/g, '');\n\n  // Validate length\n  if (sanitizedName.length \u003e 100) {\n    return res.status(400).json({ error: 'Name too long' });\n  }\n\n  if (sanitizedMessage.length \u003e 1000) {\n    return res.status(400).json({ error: 'Message too long' });\n  }\n\n  // Safe processing - no eval, no exec\n  const result = {\n    name: sanitizedName,\n    message: sanitizedMessage,\n    timestamp: Date.now(),\n    processedBy: 'protected API'\n  };\n\n  res.status(200).json(result);\n}",
