                "id": "registration:v1:5a4d84c4c7232f261c44396d339b205d2715fa4cbe2110d8eacf2d27c8afea47",
                "entry_id": "entry:v1:20fdda3b42aa4a6148b884ce9879729c15d647e1f9faf5b12489de7a3210f529",
                "origin": {
                  "kind": "entry_registration",
                  "text": "export async function POST(request: Request) {\n  try {\n    const parsed = await parseBody(request, siemAuthBodySchema);\n    if (!parsed.success) return parsed.response;\n    const { username, password } = parsed.data;\n\n    if (username === SIEM_USER \u0026\u0026 password === SIEM_PASS) {\n      const response = NextResponse.json({ success: true });\n      response.cookies.set(\"siem_session\", \"authenticated\", {\n        httpOnly: true,\n        path: \"/\",\n        maxAge: 60 * 60 * 24,\n      });\n      return response;\n    }\n\n    return NextResponse.json({ error: \"Invalid credentials\" }, { status: 401 });\n  } catch {\n    return NextResponse.json({ error: \"Invalid request\" }, { status: 400 });\n  }\n}",
                  "span": {
                    "file": "app/api/monitoring/auth/route.ts",
