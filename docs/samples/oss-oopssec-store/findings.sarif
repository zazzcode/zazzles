                "origin": {
                  "kind": "entry_registration",
                  "text": "export const DELETE = withAuth(async (_request, context, user) =\u003e {\n  try {\n    const { id, itemId } = await context.params;\n\n    const wishlist = await prisma.wishlist.findUnique({\n      where: { id },\n    });\n\n    if (!wishlist) {\n      return NextResponse.json(\n        { error: \"Wishlist not found\" },\n        { status: 404 }\n      );\n    }\n\n    if (wishlist.userId !== user.id) {\n      return NextResponse.json({ error: \"Forbidden\" }, { status: 403 });\n    }\n\n    const item = await prisma.wishlistItem.findUnique({\n      where: { id: itemId },\n    });\n\n    if (!item || item.wishlistId !== id) {\n      return NextResponse.json(\n        { error: \"Item not found in wishlist\" },\n        { status: 404 }\n      );\n    }\n\n    await prisma.wishlistItem.delete({\n      where: { id: itemId },\n    });\n\n    return NextResponse.json({ success: true });\n  } catch (error) {\n    logger.error(\n      { err: error, route: \"/api/wishlists/[id]/items/[itemId]\" },\n      \"Error removing item from wishlist\"\n    );\n    return NextResponse.json(\n      { error: \"Failed to remove item from wishlist\" },\n      { status: 500 }\n    );\n  }\n});",
                  "span": {
