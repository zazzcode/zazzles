                  "model_text": "app.post('/api/parse-yaml', (req: Request, res: Response) =\u003e {\n  const { yamlContent } = req.body;\n  try {\n                                                          \n    const parsed = yaml.safeLoad(yamlContent);\n    res.json(parsed);\n  } catch (error: any) {\n    res.status(400).json({ error: error.message });\n  }\n})",
