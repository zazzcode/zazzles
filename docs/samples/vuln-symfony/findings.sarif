      "properties": {
        "scan.checkMatches": null,
        "scan.findingTypes": [
          {
            "id": "dom-xss",
            "label": "Client-side XSS",
            "description": "Browser or API data reaches a DOM or framework rendering operation in an active output context.",
            "interpretation": "Client entries identify browser sources and verified sinks. Raw flows are construction findings; unknown origin, trust-to-template linkage or API response mapping remains Review. Framework defaults can protect a specific output.",
            "remediation": "Prefer text APIs and default framework escaping/sanitization. Sanitize rich HTML before rendering, remove unnecessary trust bypasses and verify API origins.",
            "coverage": "bounded browser DOM and Angular/React/Vue analysis"
          },
          {
            "id": "rendering-flow-review",
            "label": "Rendering Flow Review",
            "description": "Data returned by an API needs its browser consumer linked before a rendering claim can be assessed.",
            "interpretation": "JSON output alone is not an XSS sink or a vulnerability. This record is incomplete flow context for further analysis.",
            "remediation": "Locate the browser consumer, establish its output context and protections, and assess that rendering flow before changing API data handling.",
            "coverage": "bounded API response evidence"
          },
          {
            "id": "sql-injection",
            "label": "SQL Injection",
            "description": "Input changes executable SQL structure instead of remaining a data value, potentially changing what the database reads or writes.",
            "interpretation": "An SQL Injection pill identifies the risk family being reviewed. String-built executable SQL is poor practice to remediate even without a proven exploit; a library-managed search value may remain unresolved. The finding status and evidence determine the actual claim. The pill alone does not confirm injection.",
            "remediation": "Use the verified driver's parameter-binding API for values. Review dynamic identifiers separately. Keep business-field validation independent of query-structure protection.",
            "coverage": "bounded analysis"
          },
          {
            "id": "nosql-injection",
            "label": "NoSQL Injection",
            "description": "Untrusted input changes a NoSQL query's operators, selector structure, or executable expression rather than remaining an allowed data value.",
            "interpretation": "Executable $where string construction is poor practice to refactor even without a proven exploit. An unmodeled document constraint alone is Review, not an established defect. Inspect actual value types, keys, transformations, library behavior, and the named status.",
            "remediation": "Prefer data-only query APIs, constrain scalar slots and permitted keys/operators, and avoid building executable $where strings from input.",
            "coverage": "bounded analysis"
          },
          {
            "id": "command-injection",
            "label": "Command Injection",
            "description": "Request-controlled values reach an operating-system process: shell command text, the executable, a separate argument or process shell configuration.",
            "interpretation": "One record per process use, with separate shell-syntax, executable-selection and argument facets under a declared POSIX assumption. A confirmed record is a static source judgment, not runtime exploitation or independent Findings Review. Shell-disabled argument arrays do not by themselves establish protection; an unknown utility's options and unmodeled platform behavior remain Review.",
            "remediation": "Prefer eliminating process execution. Otherwise use a fixed trusted absolute executable, pass values as separate arguments with the shell disabled, and enforce utility-specific constraints such as a finite set of permitted values. Do not rely on stripping punctuation or on `--` as a universal option terminator.",
            "coverage": "bounded Node child_process and Python os/subprocess analysis"
          },
          {
            "id": "path-traversal",
            "label": "Path Traversal",
            "description": "A request-controlled value selects the file a read or write operation opens, so '..' segments, an absolute path or an unconstrained name can reach files outside the intended directory.",
            "interpretation": "One record per filesystem use, with separate traversal, containment-control and coverage assessments under a declared POSIX assumption. A confirmed record is a static source judgment (CWE-22), not runtime exploitation or independent Findings Review. Normalization, join or resolve calls, a '..' blacklist, a prefix check without a separator and error handling do not establish containment. Framework file-serving wrappers, uploads, deletes, archives and symbolic-link or race behavior are not modeled and stay Review or uncovered.",
            "remediation": "Select files by a trusted identifier or a finite allow-list. Otherwise resolve the final path and enforce a path-component-boundary containment check against the trusted directory before the operation, and decide deliberately how symbolic links are treated.",
            "coverage": "bounded Node fs and Python open/io.open/pathlib read and write analysis"
          },
          {
            "id": "input-validation",
            "label": "Input Validation",
            "description": "Server-side checks enforce the business requirements for a field, such as required presence, runtime type, permitted format, range, or length.",
            "interpretation": "Poor input validation means an applicable requirement is not adequately enforced. This neutral family label also covers unresolved checks and supported protection: no validator identified in an analyzed slice is not proof that every execution path lacks validation. Free-text punctuation is not itself a defect.",
            "remediation": "Define field-specific requirements and enforce them before use on all applicable paths. Verify guard behavior and middleware. Apply destination-specific protection separately.",
            "coverage": "bounded analysis"
          },
          {
            "id": "account-creation-validation",
            "label": "Account Creation Validation",
            "description": "Required account fields and enforcing guards must be checked before an account is persisted.",
            "interpretation": "Review field requirements, conditional bypasses, and generated persistence behavior. A modeled create operation alone does not prove a registration bypass.",
            "remediation": "Enforce required fields before persistence, terminate rejected paths, add appropriate database constraints, and test the persisted result.",
            "coverage": "bounded analysis"
          },
          {
            "id": "server-side-request-forgery",
            "label": "Server-Side Request Forgery",
            "description": "A request-controlled value chooses the destination of an outbound HTTP request the server makes, so it can reach hosts the requester cannot reach directly.",
            "interpretation": "One record per outbound call whose destination operand a request value reaches through a verified client, with separate destination-control, restriction and coverage assessments. A confirmed record is a static source judgment (CWE-918), not network reachability, DNS, redirect or deployment-policy analysis. A string prefix test is poor practice, not a restriction. Second-order destinations and unverified clients stay outbound observations.",
            "remediation": "Select destinations from a fixed table of trusted URLs. Otherwise parse the URL, allow-list scheme and host before the request, and disable or re-check redirects.",
            "coverage": "bounded global fetch, axios and Python requests/httpx/urllib destination analysis"
          },
          {
            "id": "outbound-request-safety",
            "label": "Outbound Request Safety",
            "description": "Input used in an outbound request may affect its destination, headers, or other request values. Unrestricted destination control can lead to server-side request forgery (SSRF).",
            "interpretation": "The current scanner records bounded outbound-use evidence. A pill does not establish SSRF, destination reachability, or complete response-flow analysis.",
            "remediation": "Verify allowed destinations and protocols, redirect handling, network boundaries, and sensitive request values for the specific HTTP client.",
            "coverage": "bounded analysis"
          },
          {
            "id": "reflected-xss",
            "label": "Reflected XSS",
            "description": "Request-controlled content is reflected into a browser response in a context that allows it to execute as script.",
            "interpretation": "Request input reaches an HTML response or template output. Raw output is a construction finding; unknown context or sanitizers remain Review. Escaping protects only its modeled output context. Runtime exploitation is not implied.",
            "remediation": "Use context-appropriate output encoding and safe template or DOM APIs. Input validation alone does not replace correct output handling.",
            "coverage": "bounded server response and template analysis"
          },
          {
            "id": "stored-xss",
            "label": "Stored XSS",
            "description": "Untrusted data is persisted and later rendered in an active browser context.",
            "interpretation": "A matching model and field link source writes to rendering reads. Unresolved write origins remain Review; a verified raw path is a construction finding. A dependency version alone does not establish a reachable XSS flow.",
            "remediation": "Preserve the intended stored data; apply context-appropriate escaping or maintained sanitization at every rendering sink, and review existing stored content.",
            "coverage": "bounded model-field write/read and server template analysis"
          },
          {
            "id": "sensitive-data-logging",
            "label": "Sensitive Data Logging",
            "description": "Logs expose credentials, tokens, personal information, or other sensitive values to readers or storage that should not receive them.",
            "interpretation": "Covers verified console and winston calls in analyzed route handlers that receive request values with credential or personal-data evidence. A field name is a hint for review, not proof; Authorization and Cookie headers are credentials by HTTP semantics. Morgan request logging that records URLs is checked against credentials read from the query string. Constant messages are not leaks. Non-request secrets and logger redaction configuration are not yet analyzed.",
            "remediation": "Avoid logging secrets; minimize sensitive fields and apply verified redaction before emission. Review log access and retention.",
            "coverage": "bounded analysis"
          },
          {
            "id": "sensitive-operation-review",
            "label": "Sensitive Operation Review",
            "description": "A possible sensitive use was recorded but does not yet map to a more specific supported risk family.",
            "interpretation": "This is an analysis category. Inspect the evidence and missing operation semantics before making a security claim.",
            "remediation": "Resolve the source, operation, API behavior, and required protection before selecting a fix.",
            "coverage": "bounded analysis"
          },
          {
            "id": "template-injection",
            "label": "Server-Side Template Injection",
            "description": "Request text is compiled as template source by a server-side template engine.",
            "interpretation": "Template source and render variables are separate operands; only source compiled by a verified engine is this claim. A shared construction also has its XSS record.",
            "remediation": "Keep the template constant and pass request values as render variables.",
            "coverage": "bounded template-engine source analysis"
          },
          {
            "id": "unsafe-deserialization",
            "label": "Unsafe deserialization",
            "description": "Request-controlled bytes reach a deserializer that supports code execution or object injection.",
            "interpretation": "What the format can do is a fact of the verified operation and its options, not a judgment. Code execution is by format design; for object injection the effect depends on the classes available, and no gadget chain is claimed. Decoding, format checks and unkeyed hashes are not protection.",
            "remediation": "Use a data-only format or loader for untrusted bytes.",
            "coverage": "verified deserializer and request data paths"
          },
          {
            "id": "unrestricted-upload",
            "label": "Unrestricted File Upload",
            "description": "A client upload is stored with a client-chosen type where it can be served.",
            "interpretation": "The stored name, server-side type controls and destination are source facts; path containment is a separate claim.",
            "remediation": "Generate the stored name, derive or allow-list the extension on the server, check or re-encode content, and store uploads outside the served tree.",
            "coverage": "bounded upload write analysis"
          },
          {
            "id": "information-exposure",
            "label": "Information Exposure",
            "description": "A diagnostic operation whose output reveals server configuration, environment, runtime state or a stack is reachable from an entry (CWE-200, CWE-215).",
            "interpretation": "The operation and what it reveals are facts of the verified diagnostic contract. Conditions that dominate the operation are recorded as evidence, and whether they restrict the caller is judged. Dumping an ordinary local value is not this claim. Framework dump() output depends on the debug environment and stays Review.",
            "remediation": "Remove the diagnostic operation from served code, or restrict it to an authenticated administrator and a non-production environment.",
            "coverage": "bounded PHP diagnostic-output analysis"
          },
          {
            "id": "mass-assignment",
            "label": "Mass Assignment",
            "description": "A request chooses the names of the properties written on an object that has a field the request should not choose (CWE-915).",
            "interpretation": "The record establishes that the property names come from the request, how they are written and which fields of the target carry a credential, login identifier or role source by framework contract. A field-name hint is weighed, not trusted. A key allow-list is a control whose adequacy is judged. Form, serializer and payload mapping are recorded in Review. Whether a named write is authorized is a separate claim.",
            "remediation": "Write each permitted field through a named setter from a named request field, or intersect the request keys with a literal allow-list that excludes privilege, credential and identity fields.",
            "coverage": "bounded PHP key-controlled write analysis"
          },
          {
            "id": "missing-authorization",
            "label": "Missing Authorization",
            "description": "An operation changes or reveals a record the request selects without a guard or an entry rule that covers it (CWE-862, CWE-639).",
            "interpretation": "The record lists the subject, the operation, the entry's access and the guards that dominate the operation. A guard is evidence. Whether it is enough is judged. A role name is a string.",
            "remediation": "Authorize the operation on the selected record, and require the same access on every entry that writes the field.",
            "coverage": "bounded PHP authorization analysis"
          },
          {
            "id": "address-based-access",
            "label": "Address-Based Access",
            "description": "An operation is limited by the caller's network address (CWE-291).",
            "interpretation": "An address check is a property of the connection, not of the user. A framework client address depends on trusted-proxy configuration, which is recorded as unread until that configuration is read.",
            "remediation": "Do not authorize a state change from the peer address alone. Require an authenticated caller and authorize the operation on the selected record.",
            "coverage": "bounded PHP address-check analysis"
          },
          {
            "id": "account-enumeration",
            "label": "Account Enumeration",
            "description": "An entry that needs no login looks up an account by a request value and answers differently when the account exists (CWE-204).",
            "interpretation": "The record holds the lookup, its result branch and the responses on each side, compared with each other. The scanner does not read meaning into the wording; whether the difference reveals an account is judged. Timing differences are not recorded.",
            "remediation": "Give the found and not-found branches the same response, and move account-specific messages to a channel the account owner controls.",
            "coverage": "bounded PHP lookup-branch-response analysis"
          },
          {
            "id": "weak-password-recovery",
            "label": "Weak Password Recovery",
            "description": "A generated recovery secret is mailed to a recipient the request controls beyond what a check covered, or the secret is guessable (CWE-640, CWE-1287).",
            "interpretation": "The record holds the secret source and its strength, the stored field, the recipient's origin and the checks that tied it to the account. A request value used as an array can name many recipients; a check of one element covers only that element. Mail content is a delivery sink for this claim only.",
            "remediation": "Send the recovery secret only to the address stored for the account, generate it from a cryptographically secure source, and accept only a scalar identifier from the request.",
            "coverage": "bounded PHP recovery-secret delivery analysis"
          },
          {
            "id": "weak-password-hash",
            "label": "Weak Password Hash",
            "description": "A password is stored as one fast digest such as md5 or sha1 (CWE-916).",
            "interpretation": "A password is established by evidence: a census credential field, a password-hasher class or the security configuration. A variable name alone establishes nothing. A salt does not make a fast digest adaptive.",
            "remediation": "Hash passwords with password_hash or a Symfony password hasher configured with algorithm auto, and rehash stored digests on the next login.",
            "coverage": "bounded PHP password-digest analysis"
          },
          {
            "id": "insecure-configuration",
            "label": "Insecure Configuration",
            "description": "A framework or deployment setting weakens the application in a way the joined facts make concrete (CWE-548, CWE-352, CWE-1004, CWE-614, CWE-489, CWE-98, CWE-732, CWE-269).",
            "interpretation": "The record holds one setting, its scope and the application facts it joins. The scanner does not decide that the setting is a defect. A hardened value is not recorded.",
            "remediation": "Change the setting, or keep the joined condition from applying: disable directory listing where uploads are stored, keep CSRF protection on for state-changing entries, mark the session cookie HttpOnly and Secure, and do not run a writable project file from a privileged schedule.",
            "coverage": "bounded framework and deployment configuration analysis"
          }
        ],
        "scan.identityPolicy": "snapshot-local use IDs; edit-stable baseline identity is not implemented",
        "scan.limitations": [
          "ESM relative imports, literal CommonJS requires and direct exported handlers are resolved; dynamic imports, re-exports and mutated module bindings remain uncertain",
