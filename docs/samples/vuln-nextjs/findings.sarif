              "location": {
                "model_text": "export default function handler(req, res) {\n  if (req.method !== 'POST') {\n    return res.status(405).json({ error: 'Method not allowed' });\n  }\n\n  const { filePath } = req.body;\n\n  if (!filePath) {\n    return res.status(400).json({ error: 'No file path provided' });\n  }\n\n  console.log(`[VULNERABLE] Reading file: ${filePath}`);\n\n  try {\n                                                                            \n                                                                      \n    const fileContent = fs.readFileSync(filePath, 'utf8');\n\n    res.status(200).json({\n      success: true,\n      filePath: filePath,\n      content: fileContent,\n      size: fileContent.length,\n      timestamp: Date.now()\n    });\n  } catch (error) {\n    res.status(500).json({\n      error: error.message,\n      code: error.code,\n      filePath: filePath\n    });\n  }\n}",
                "kind": "entry_registration",
                "text": "export default function handler(req, res) {\n  if (req.method !== 'POST') {\n    return res.status(405).json({ error: 'Method not allowed' });\n  }\n\n  const { filePath } = req.body;\n\n  if (!filePath) {\n    return res.status(400).json({ error: 'No file path provided' });\n  }\n\n  console.log(`[VULNERABLE] Reading file: ${filePath}`);\n\n  try {\n    // EXTREMELY DANGEROUS: Reading user-specified files without validation!\n    // This allows attackers to read any file the server has access to\n    const fileContent = fs.readFileSync(filePath, 'utf8');\n\n    res.status(200).json({\n      success: true,\n      filePath: filePath,\n      content: fileContent,\n      size: fileContent.length,\n      timestamp: Date.now()\n    });\n  } catch (error) {\n    res.status(500).json({\n      error: error.message,\n      code: error.code,\n      filePath: filePath\n    });\n  }\n}",
