              {
                "id": "entry:v1:1eed3561a60d425e1f2278db3224f2381fd9b506278f16d884f07c860c1da92c",
                "kind": "http",
                "name": "GET /api/flags",
                "instance_id": "app/api/flags/route.ts:54199790b9b8aca4aef97f33c846c6d2d325b1132d8187736df1b1822c5a07b3:nextjs",
                "location": {
                  "kind": "entry_registration",
                  "text": "export async function GET() {\n  try {\n    const flags = await prisma.flag.findMany({\n      orderBy: {\n        slug: \"asc\",\n      },\n      select: {\n        id: true,\n        flag: true,\n        slug: true,\n        cve: true,\n        cwe: true,\n        owasp: true,\n        markdownFile: true,\n        walkthroughSlug: true,\n        category: true,\n        difficulty: true,\n        foundFlag: { select: { id: true } },\n      },\n    });\n\n    return NextResponse.json(\n      flags.map(({ foundFlag, flag, ...rest }) =\u003e ({\n        ...rest,\n        flag: foundFlag ? flag : null,\n      }))\n    );\n  } catch (error) {\n    logger.error({ err: error, route: \"/api/flags\" }, \"Error fetching flags\");\n    return NextResponse.json(\n      { error: \"Failed to fetch flags\" },\n      { status: 500 }\n    );\n  }\n}",
