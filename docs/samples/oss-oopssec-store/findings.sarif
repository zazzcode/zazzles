            "scan.dispatchBinding": {
              "id": "dispatch:v1:1453957ed884630bbe5b2aacc7357e01ce9ceffb93b23501bf1648c84d61cddb",
              "entry_id": "entry:v1:6678d1edd3fca99871c2cf0a279f816192782195317c39ad62864a172f50e1de",
              "registration_id": "registration:v1:0a8e38b38ede74a3b1c90324d4b8eb646c7c48150bf2108b66a072136ce5080c",
              "callable_id": "callable:v1:ee3cb9576663f4128b8a63cd9c2f648f15a3aa10867d83ec4051757193200f23",
