                  "sha256": "f934f2d3f6347eebe47a30f0c5eecc87580e49481b53128d797ae5f8f8028aed"
                },
                "framework": "nextjs"
              },
              {
                "declared_handler": {
                  "name": "POST",
                  "kind": "function",
                  "span": {
                    "file": "app/api/mcp/route.ts",
                    "start_line": 168,
                    "end_line": 209,
                    "start_byte": 5172,
                    "end_byte": 6444
