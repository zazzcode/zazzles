                "id": "registration:v1:ec534476e42051595ab2d17cd2052157e199bb18700e5aeb3245272e9c0c5a43",
                "entry_id": "entry:v1:6b8c1bd8c26b89bd7c8fae74961de88e0a6eedc87a159aff54a1a92f39392564",
                "origin": {
                  "model_text": "export async function generateMetadata({\n  params,\n}: VulnerabilityPageProps): Promise\u003c{ title: string; description: string }\u003e {\n  const { slug } = await params;\n  const flag = await getFlagBySlug(slug);\n\n  if (!flag) {\n    return {\n      title: \"Vulnerability Not Found\",\n      description: \"The requested vulnerability could not be found\",\n    };\n  }\n\n  return {\n                                                                          \n    title: `${formatSlug(flag.slug)} - ${flag.cve || \"Vulnerability\"}`,\n    description: `Learn about the ${flag.slug} vulnerability`,\n  };\n}",
                  "kind": "entry_registration",
                  "text": "export async function generateMetadata({\n  params,\n}: VulnerabilityPageProps): Promise\u003c{ title: string; description: string }\u003e {\n  const { slug } = await params;\n  const flag = await getFlagBySlug(slug);\n\n  if (!flag) {\n    return {\n      title: \"Vulnerability Not Found\",\n      description: \"The requested vulnerability could not be found\",\n    };\n  }\n\n  return {\n    // Never the flag value: this page is meant to be read before solving.\n    title: `${formatSlug(flag.slug)} - ${flag.cve || \"Vulnerability\"}`,\n    description: `Learn about the ${flag.slug} vulnerability`,\n  };\n}",
                  "span": {
                    "file": "app/vulnerabilities/[slug]/page.tsx",
