              {
                "id": "entry:v1:22753c7fe370690a81d4e1c9784b6c7353145dd3b26f0d49261be1039546afbb",
                "kind": "http",
                "name": "GET /products/:id",
                "instance_id": "app/products/[id]/page.tsx:69dba80dbd8faf353e094e060dfb1a8639f38460eb93146ec87c2a74fb773646:nextjs",
                "location": {
                  "kind": "entry_registration",
                  "text": "export default async function ProductPage({\n  params,\n}: {\n  params: Promise\u003c{ id: string }\u003e;\n}) {\n  const { id } = await params;\n  const product = await getProduct(id);\n\n  if (!product) {\n    notFound();\n  }\n\n  return (\n    \u003cdiv className=\"flex min-h-screen flex-col bg-white dark:bg-slate-900\"\u003e\n      \u003cHeader /\u003e\n      \u003cmain className=\"flex-1\"\u003e\n        \u003cProductDetailClient product={product} /\u003e\n      \u003c/main\u003e\n      \u003cFooter /\u003e\n    \u003c/div\u003e\n  );\n}",
