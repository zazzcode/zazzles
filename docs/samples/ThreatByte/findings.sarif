                {
                  "kind": "template",
                  "text": "\u003c!DOCTYPE html\u003e\n\u003chtml lang=\"en\"\u003e\n\u003chead\u003e\n    \u003cmeta charset=\"UTF-8\"\u003e\n    \u003cmeta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"\u003e\n    \u003ctitle\u003eEdit Profile\u003c/title\u003e\n    \u003clink rel=\"stylesheet\" href=\"{{ url_for('static', filename='css/styles.css') }}\"\u003e\n\u003c/head\u003e\n\u003cbody\u003e\n    \u003cheader\u003e\n        \u003ch1\u003eEdit Profile\u003c/h1\u003e\n        \u003cnav\u003e\n            \u003cul\u003e\n                \u003cli\u003e\u003ca href=\"{{ url_for('dashboard') }}\"\u003eDashboard\u003c/a\u003e\u003c/li\u003e\n                \u003cli\u003e\u003ca href=\"{{ url_for('logout') }}\"\u003eLog Out\u003c/a\u003e\u003c/li\u003e\n            \u003c/ul\u003e\n        \u003c/nav\u003e\n    \u003c/header\u003e\n    \u003cmain\u003e\n        \u003cdiv id=\"flash-message\"\u003e\n            {% with messages = get_flashed_messages(with_categories=true) %}\n                {% if messages %}\n                    \u003cdiv class=\"flash {{ messages[0][0] }}\"\u003e{{ messages[0][1] }}\u003c/div\u003e\n                {% endif %}\n            {% endwith %}\n        \u003c/div\u003e\n        \n        \u003csection\u003e\n            \u003cform action=\"{{ url_for('update_profile') }}\" method=\"POST\" enctype=\"multipart/form-data\"\u003e\n                \u003clabel for=\"username\"\u003eUsername\u003c/label\u003e\n                \u003cinput type=\"text\" id=\"username\" name=\"username\" value=\"{{ user.username }}\"\u003e\n\n                \u003clabel for=\"email\"\u003eEmail\u003c/label\u003e\n                \u003cinput type=\"email\" id=\"email\" name=\"email\" value=\"{{ user.email }}\"\u003e\n\n                \u003clabel for=\"country\"\u003eCountry\u003c/label\u003e\n                \u003cinput type=\"text\" id=\"country\" name=\"country\" value=\"{{ user.country }}\"\u003e\n\n                \u003c!-- \u003clabel for=\"role\"\u003eRole\u003c/label\u003e\n                \u003cinput type=\"text\" id=\"role\" name=\"role\" value=\"{{ user.role }}\"\u003e\n\n                \u003clabel for=\"permissions\"\u003ePermissions\u003c/label\u003e\n                \u003cinput type=\"text\" id=\"permissions\" name=\"permissions\" value=\"{{ user.permissions }}\"\u003e --\u003e\n\n                \u003clabel for=\"team\"\u003eTeam\u003c/label\u003e\n                \u003cinput type=\"text\" id=\"team\" name=\"team\" value=\"{{ user.team }}\"\u003e\n\n                \u003clabel for=\"profile_picture\"\u003eProfile Picture\u003c/label\u003e\n                \u003cinput type=\"file\" id=\"profile_picture\" name=\"profile_picture\"\u003e\n\n                \u003cbutton type=\"submit\"\u003eUpdate Profile\u003c/button\u003e\n            \u003c/form\u003e\n        \u003c/section\u003e\n    \u003c/main\u003e\n    \u003cfooter\u003e\n        \u003cp\u003e\u0026copy; 2024 ThreatByteLand\u003c/p\u003e\n    \u003c/footer\u003e\n\n    \u003cscript src=\"https://code.jquery.com/jquery-3.6.0.min.js\"\u003e\u003c/script\u003e\n    \u003cscript\u003e\n        $(document).ready(function() {\n            // Show flash messages if present\n            $('#flash-message .flash').each(function() {\n                $(this).fadeIn().delay(3000).fadeOut();\n            });\n        });\n    \u003c/script\u003e\n\u003c/body\u003e\n\u003c/html\u003e\n",
