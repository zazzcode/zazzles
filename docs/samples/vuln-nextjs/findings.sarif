                "location": {
                  "model_text": "export async function getServerSideProps({ query }) {\n  const userInput = query.input || 'Hello World';\n\n                            \n  if (typeof userInput !== 'string') {\n    return {\n      props: {\n        userInput: '',\n        sanitizedInput: 'Invalid input type',\n        rawQuery: 'Type validation failed'\n      }\n    };\n  }\n\n                              \n  if (userInput.length \u003e 200) {\n    return {\n      props: {\n        userInput: '',\n        sanitizedInput: 'Input too long',\n        rawQuery: userInput.substring(0, 50) + '...'\n      }\n    };\n  }\n\n                                                      \n  const sanitizedInput = userInput.replace(/[^a-zA-Z0-9\\s\\-_.]/g, '');\n\n                                                                 \n  const dangerousPatterns = [\n    /eval\\(/i,\n    /require\\(/i,\n    /child_process/i,\n    /exec\\(/i,\n    /\u003cscript/i,\n    /javascript:/i,\n    /\\$\\{/,                      \n    /process\\./i\n  ];\n\n  for (const pattern of dangerousPatterns) {\n    if (pattern.test(userInput)) {\n      return {\n        props: {\n          userInput: '',\n          sanitizedInput: 'Blocked: Dangerous pattern detected',\n          rawQuery: 'Security check failed'\n        }\n      };\n    }\n  }\n\n  return {\n    props: {\n      userInput,\n      sanitizedInput,\n      rawQuery: userInput\n    }\n  };\n}",
                  "kind": "entry_registration",
                  "text": "export async function getServerSideProps({ query }) {\n  const userInput = query.input || 'Hello World';\n\n  // Step 1: Type validation\n  if (typeof userInput !== 'string') {\n    return {\n      props: {\n        userInput: '',\n        sanitizedInput: 'Invalid input type',\n        rawQuery: 'Type validation failed'\n      }\n    };\n  }\n\n  // Step 2: Length validation\n  if (userInput.length \u003e 200) {\n    return {\n      props: {\n        userInput: '',\n        sanitizedInput: 'Input too long',\n        rawQuery: userInput.substring(0, 50) + '...'\n      }\n    };\n  }\n\n  // Step 3: Sanitization - only allow safe characters\n  const sanitizedInput = userInput.replace(/[^a-zA-Z0-9\\s\\-_.]/g, '');\n\n  // Step 4: Additional validation - check for dangerous patterns\n  const dangerousPatterns = [\n    /eval\\(/i,\n    /require\\(/i,\n    /child_process/i,\n    /exec\\(/i,\n    /\u003cscript/i,\n    /javascript:/i,\n    /\\$\\{/,  // Template literals\n    /process\\./i\n  ];\n\n  for (const pattern of dangerousPatterns) {\n    if (pattern.test(userInput)) {\n      return {\n        props: {\n          userInput: '',\n          sanitizedInput: 'Blocked: Dangerous pattern detected',\n          rawQuery: 'Security check failed'\n        }\n      };\n    }\n  }\n\n  return {\n    props: {\n      userInput,\n      sanitizedInput,\n      rawQuery: userInput\n    }\n  };\n}",
