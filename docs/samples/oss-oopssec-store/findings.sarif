              {
                "id": "entry:v1:000d83b0db2030542f6fb70e64dda59f7adc4ffe6118d610175a4aff20634744",
                "kind": "http",
                "name": "GET /api/mcp-config",
                "instance_id": "app/api/mcp-config/route.ts:ad266f3b111953baee0b55fb3a5e7b6305fd1b9e5a441537ad7c4f112aee1d0c:nextjs",
                "location": {
                  "kind": "entry_registration",
                  "text": "export function GET() {\n  const config = {\n    mcpServers: {\n      \"hf-mcp-server\": {\n        command: \"npx\",\n        args: [\"-y\", \"@llmindset/hf-mcp-server\"],\n        env: { HF_TOKEN: LEAKED_HUB_TOKEN },\n      },\n      \"support-evals\": {\n        command: \"uv\",\n        args: [\"run\", \"--directory\", \"tools/support-evals\", \"server.py\"],\n        env: {\n          HF_ENDPOINT: `${getBaseUrl()}${MIRROR_PATH}`,\n          HF_TOKEN: LEAKED_HUB_TOKEN,\n        },\n      },\n    },\n  };\n\n  return new NextResponse(`${JSON.stringify(config, null, 2)}\\n`, {\n    headers: { \"Content-Type\": \"application/json\" },\n  });\n}",
                  "span": {
