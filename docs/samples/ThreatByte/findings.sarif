                  "kind": "helper_definition",
                  "text": "def get_db_connection():\n    conn = sqlite3.connect(DATABASE_URI)\n    conn.row_factory = sqlite3.Row  # This allows name-based access to columns\n    return conn",
                  "span": {
                    "file": "db/initialize_db.py",
