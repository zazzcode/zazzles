            "scan.entry": {
              "id": "entry:v1:8c0079452138e032a37d2a62662dfe9f1753616dd86e6342ccb557c561db97d8",
              "kind": "http",
              "name": "POST /api/orders/:id/share",
              "instance_id": "app/api/orders/[id]/share/route.ts:d1199f7d7c3b9d75062b32dd02787a1192479a0602a0f47cc8ee53a759fd8bf8:nextjs",
              "location": {
                "kind": "entry_registration",
                "text": "export const POST = withAuth(async (request: NextRequest, context, user) =\u003e {\n  try {\n    const { id } = await context.params;\n\n    const order = await prisma.order.findUnique({\n      where: { id, userId: user.id },\n    });\n\n    if (!order) {\n      return NextResponse.json({ error: \"Order not found\" }, { status: 404 });\n    }\n\n    const token = encryptShareToken(`order:${id}`);\n\n    const protocol = request.headers.get(\"x-forwarded-proto\") || \"http\";\n    const host = request.headers.get(\"host\") || \"localhost:3000\";\n    const shareUrl = `${protocol}://${host}/api/documents/share?token=${token}`;\n\n    return NextResponse.json({ shareUrl, token });\n  } catch (error) {\n    logger.error(\n      { err: error, route: \"/api/orders/[id]/share\" },\n      \"Error generating share link\"\n    );\n    return NextResponse.json(\n      { error: \"Failed to generate share link\" },\n      { status: 500 }\n    );\n  }\n});",
                "span": {
                  "file": "app/api/orders/[id]/share/route.ts",
                  "start_line": 7,
                  "end_line": 36,
                  "start_byte": 238,
                  "end_byte": 1144
