                },
                {
                  "kind": "helper_definition",
                  "text": "public function __construct(\n        private readonly bool $trackingEnabled,\n        private readonly LoggerInterface $logger\n    )\n    {\n    }",
                  "span": {
                    "file": "src/Services/Analytics.php",
                    "start_line": 9,
                    "end_line": 14,
                    "start_byte": 84,
                    "end_byte": 227
