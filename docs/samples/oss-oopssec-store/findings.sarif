                  "text": "export default function DocumentsPage() {\n  return (\n    \u003cdiv className=\"flex min-h-screen flex-col bg-white dark:bg-slate-900\"\u003e\n      \u003cHeader /\u003e\n      \u003cdiv hidden dangerouslySetInnerHTML={{ __html: DEV_NOTE_HTML }} /\u003e\n      \u003cmain className=\"flex-1\"\u003e\n        \u003csection className=\"border-b border-slate-200 bg-gradient-to-br from-primary-500 via-primary-600 to-secondary-600 dark:border-slate-800\"\u003e\n          \u003cdiv className=\"container mx-auto px-4 py-16 md:py-24\"\u003e\n            \u003cdiv className=\"mx-auto max-w-4xl text-center\"\u003e\n              \u003ch1 className=\"mb-6 text-4xl font-bold tracking-tight text-white md:text-5xl\"\u003e\n                Document Repository\n              \u003c/h1\u003e\n              \u003cp className=\"text-lg text-primary-50 md:text-xl\"\u003e\n                Access secure documents and files\n              \u003c/p\u003e\n            \u003c/div\u003e\n          \u003c/div\u003e\n        \u003c/section\u003e\n        \u003csection className=\"container mx-auto px-4 py-16\"\u003e\n          \u003cDocumentsClient /\u003e\n        \u003c/section\u003e\n      \u003c/main\u003e\n      \u003cFooter /\u003e\n    \u003c/div\u003e\n  );\n}",
