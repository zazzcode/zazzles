                {
                  "kind": "render_markup_context",
                  "text": "                    \u003cp\u003e\u003cstrong\u003eTeam:\u003c/strong\u003e {{ user.team }}\u003c/p\u003e",
                  "span": {
                    "file": "client/templates/profile.html",
