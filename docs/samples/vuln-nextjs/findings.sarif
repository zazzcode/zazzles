              "location": {
                "model_text": "export default function handler(req, res) {\n  if (req.method !== 'POST') {\n    return res.status(405).json({ error: 'Method not allowed' });\n  }\n\n  const { name, message } = req.body;\n\n  try {\n                                                      \n                                                                             \n                                            \n    const result = eval(`({\n      name: '${name}',\n      message: '${message}',\n      timestamp: Date.now(),\n      processedBy: 'vulnerable-submit API'\n    })`);\n\n    res.status(200).json(result);\n  } catch (error) {\n    res.status(500).json({\n      error: error.message,\n      stack: error.stack\n    });\n  }\n}",
                "kind": "entry_registration",
                "text": "export default function handler(req, res) {\n  if (req.method !== 'POST') {\n    return res.status(405).json({ error: 'Method not allowed' });\n  }\n\n  const { name, message } = req.body;\n\n  try {\n    // EXTREMELY DANGEROUS: Using eval with user input\n    // This is the core vulnerability - attackers can break out of the string\n    // and execute arbitrary JavaScript code\n    const result = eval(`({\n      name: '${name}',\n      message: '${message}',\n      timestamp: Date.now(),\n      processedBy: 'vulnerable-submit API'\n    })`);\n\n    res.status(200).json(result);\n  } catch (error) {\n    res.status(500).json({\n      error: error.message,\n      stack: error.stack\n    });\n  }\n}",
