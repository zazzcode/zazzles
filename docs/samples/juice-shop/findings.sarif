                      "text": "{\n    try {\n      req.body.UserId = authenticatedUsers.tokenMap[utils.jwtFrom(req)].data.id\n      next()\n    } catch (error: unknown) {\n      res.status(401).json({ status: 'error', message: utils.getErrorMessage(error) })\n    }\n  }",
