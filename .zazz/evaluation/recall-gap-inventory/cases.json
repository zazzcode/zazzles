    "present": "Candidate required; the key's expectation is assessment-dependent (judge decides)",
    "no_record": "No candidate of the kind at the anchor",
    "not_raw": "Every matching xss candidate is classified other than raw (or there is none)",
    "not_decisive": "No matching candidate, or every matching candidate keeps a blocker or lacks a request origin",
    "only_lines": "Candidates of the kind in the file sit only at the listed lines",
    "bound": "No matching sql candidate carries query_text_interpolated",
    "excluded": "Outside candidate/registration recall; reason given",
    "noise_rows": "Source-reviewed anchors for keyed noise classes; the checker counts matching records that still carry the class condition"
  },
